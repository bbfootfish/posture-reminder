# RTSP over TCP; fill in the actual go2rtc stream path for 192.168.2.133
POSTURE_RTSP_URL=rtsp://192.168.2.133:8554/camera

# Static HTTP server on the PVE host that serves /opt/posture-media
POSTURE_MEDIA_BASE_URL=http://192.168.2.130:8090

# Leave empty for dry-run (log only). Uses the pre-generated MP3s.
SPEAK_CMD=python /app/tools/speak.py --class {class} --variant {variant} --url {url} --volume 35

# Local time window; outside it the service neither judges nor speaks.
WORK_HOURS=16:00-21:00
